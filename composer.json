{
    "name": "goletter/hyperf-observability",
    "description": "Hyperf ECS 日志管道与 OpenTelemetry 链路上下文。",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "goletter",
            "email": "goletter@outlook.com"
        }
    ],
    "keywords": [
        "php",
        "hyperf",
        "logging",
        "ecs",
        "opentelemetry",
        "tracing",
        "observability",
        "goletter"
    ],
    "require": {
        "php": ">=8.1",
        "hyperf/context": "~3.1.0",
        "hyperf/logger": "~3.1.0",
        "monolog/monolog": "^3.0",
        "open-telemetry/context-swoole": "^1.3",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/sdk": "^1.15",
        "open-telemetry/sem-conv": "^1.44",
        "psr/http-message": "^1.0|^2.0",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "suggest": {
        "hyperf/framework": "在 Hyperf 中使用 ConfigProvider / DI 时需要。",
        "hyperf/http-server": "CodePoint::server() / TraceHeaders::applyCors() 需要。"
    },
    "autoload": {
        "psr-4": {
            "Goletter\\Observability\\": "src/"
        }
    },
    "extra": {
        "hyperf": {
            "config": "Goletter\\Observability\\ConfigProvider"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
